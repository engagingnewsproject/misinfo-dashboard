# Caffeine App build settings. Copy to .env (in caffeine-app-v2, or here to preview Caffeine locally)
# and fill in the blanks from Firebase Console → Project settings → caffeine-app-d8cd8 web app.
# On Netlify, set the same variables under Site configuration → Environment variables.

NEXT_PUBLIC_BRAND=caffeine

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=caffeine-app-d8cd8.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=caffeine-app-d8cd8
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=caffeine-app-d8cd8.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_RECAPTCHA_ENTERPRISE_SITE_KEY=
NEXT_PUBLIC_APP_URL=https://caffeine-dashboard.netlify.app

# Local only
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=
NEXT_PUBLIC_USE_EMULATORS=false

# Server-side (report page SSR + scripts). Path is relative to the repo root.
GOOGLE_APPLICATION_CREDENTIALS=./caffeine-app-d8cd8-firebase-adminsdk-c2qxc-9cfdbf0310.json
