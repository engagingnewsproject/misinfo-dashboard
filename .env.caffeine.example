# Caffeine Dashboard build settings. Copy to .env here to preview Caffeine locally
# and fill in the blanks from Firebase Console → Project settings → caffeine-app-d8cd8 web app.
# On Netlify, set the same variables under Site configuration → Environment variables.

NEXT_PUBLIC_BRAND=caffeine

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=caffeine-app-d8cd8.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=caffeine-app-d8cd8
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=caffeine-app-d8cd8.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Caffeine's App Check uses plain reCAPTCHA v3 (Enterprise needs billing). Setting this
# switches App Check to v3; leave the Enterprise key blank.
NEXT_PUBLIC_FIREBASE_RECAPTCHA_V3_SITE_KEY=
NEXT_PUBLIC_FIREBASE_RECAPTCHA_ENTERPRISE_SITE_KEY=
NEXT_PUBLIC_APP_URL=https://caffeine-dashboard.netlify.app

# Caffeine Study (online study copy) only: a second Netlify site with the same values as
# above, plus these. Every report goes to "Prolific sample" instead of Test Agency.
# Both are required; the name must match the agency doc. Also set NEXT_PUBLIC_APP_URL
# to the study site's own URL. See README → "Online study copies".
# NEXT_PUBLIC_FIXED_REPORT_AGENCY_ID=
# NEXT_PUBLIC_FIXED_REPORT_AGENCY_NAME=Prolific sample

# Local only
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=
NEXT_PUBLIC_USE_EMULATORS=false

# Server-side (report page SSR + scripts). Path is relative to the repo root.
GOOGLE_APPLICATION_CREDENTIALS=./caffeine-app-d8cd8-firebase-adminsdk-c2qxc-9cfdbf0310.json
